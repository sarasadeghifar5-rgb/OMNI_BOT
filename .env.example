# ===============================================
# OmniLLM Hub - Environment Variables
# کلیدهای ارائه‌دهندگان هوش مصنوعی (اختیاری در صورت استفاده از تنظیمات درون برنامه)
# ===============================================

# 1. DeepSeek API (deepseek-reasoner R1 & deepseek-chat V3)
# دریافت از: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 2. OpenAI API (GPT-4o, o1, GPT-4o-mini)
# دریافت از: https://platform.openai.com
OPENAI_API_KEY=

# 3. xAI Grok API (Grok-2, Grok-Vision)
# دریافت از: https://console.x.ai
GROK_API_KEY=

# 4. Zhipu AI GLM API (GLM-4, GLM-4V, GLM-4-Flash)
# دریافت از: https://open.bigmodel.cn
GLM_API_KEY=

# 5. Google Gemini API (Gemini 2.0 Flash, Gemini 1.5 Pro)
# دریافت از: https://aistudio.google.com
GEMINI_API_KEY=

# 6. Anthropic Claude API (Claude 3.5 Sonnet)
# دریافت از: https://console.anthropic.com
ANTHROPIC_API_KEY=

# 7. OpenRouter API (دسترسی به بیش از ۱۰۰ مدل با یک کلید)
# دریافت از: https://openrouter.ai
OPENROUTER_API_KEY=

# 8. Tavily Search API (جستجوی وب با دقت بالا - در صورت خالی بودن از DuckDuckGo رایگان استفاده می‌شود)
# دریافت رایگان از: https://tavily.com
TAVILY_API_KEY=

# سرور محلی Ollama (در صورت نیاز به اجرای آفلاین)
OLLAMA_BASE_URL=http://localhost:11434/v1

# تنظیمات هاست
HOST=127.0.0.1
PORT=8000

# ===============================================
# 9. تنظیمات ربات تلگرام (Telegram Bot Settings)
# ===============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
BOT_MAX_CONCURRENCY=50
BOT_RATE_LIMIT=1.5
BOT_MAX_HISTORY_TURNS=12

# ===============================================
# 10. Atria ASI API (Atria-Dawn-Preview - استدلال 256K)
# دریافت از: https://api.atria-asi.ai
# ===============================================
ATRIA_API_KEY=
ATRIA_API_KEYS=
ATRIA_BASE_URL=https://api.atria-asi.ai/v1

# ===============================================
# 11. Agnes AI API (استودیو چندرسانه‌ای نانو - عکس، ویدیو، استدلال و بینایی)
# دریافت از: https://agnes-ai.com
# ===============================================
AGNES_API_KEY=
AGNES_API_KEYS=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ===============================================
# 12. Clean APIs (formerly CodeCraft API) - 33 Next-Gen Flagship Models
# Documentation: https://cleanapis.com/docs
# ===============================================
CODECRAFT_API_KEY=
CODECRAFT_API_KEYS=
CODECRAFT_BASE_URL=https://cleanapis.com/v1
CLEANAPIS_API_KEY=
CLEANAPIS_API_KEYS=
CLEANAPIS_BASE_URL=https://cleanapis.com/v1



